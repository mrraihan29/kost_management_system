# ──────────────────────────────────────────────
# Evy Kost Management System — Environment Variables
# ──────────────────────────────────────────────
# Copy file ini menjadi .env dan isi nilai-nilai yang sesuai.
# JANGAN PERNAH commit file .env ke repository!

# Django Secret Key (WAJIB di production)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=ganti-dengan-key-random-yang-sangat-panjang-dan-unik

# Debug Mode (True untuk development, False untuk production)
DJANGO_DEBUG=True

# Allowed Hosts (pisahkan dengan koma)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (PostgreSQL untuk production)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# DATABASE_URL=postgres://user:password@localhost:5432/kost_db

# CSRF Trusted Origins (untuk deployment di belakang proxy)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
